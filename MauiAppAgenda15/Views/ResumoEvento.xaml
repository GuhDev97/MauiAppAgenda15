<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppAgenda15.Views.ResumoEvento"
             Title="Resumo do Evento"
             Background="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Resumo do Evento" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource Primary}" 
                   HorizontalOptions="Center"/>

            <Border Padding="15" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray200}">
                <VerticalStackLayout Spacing="15">

                    <!-- Nome do Evento em destaque -->
                    <Label Text="{Binding Nome}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}"/>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Local:" FontAttributes="Bold"/>
                        <Label Text="{Binding Local}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Data de Início:" FontAttributes="Bold"/>
                        <Label Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Data de Término:" FontAttributes="Bold"/>
                        <Label Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Duração do Evento:" FontAttributes="Bold"/>
                        <Label Text="{Binding DuracaoDias, StringFormat='{0} dia(s)'}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Total de Participantes:" FontAttributes="Bold"/>
                        <Label Text="{Binding NumeroParticipantes}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Custo por Participante:" FontAttributes="Bold"/>
                        <Label Text="{Binding CustoPorParticipante, StringFormat='{0:C}'}"/>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>

                    <!-- Custo Total Calculado -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Custo Total:" FontAttributes="Bold" FontSize="18"/>
                        <Label Text="{Binding CustoTotal, StringFormat='{0:C}'}" 
                               FontSize="18" 
                               TextColor="{StaticResource Primary}" 
                               FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Text="Voltar" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="White" 
                    Clicked="OnVoltarClicked" 
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>